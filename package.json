{
  "name": "lru-ts",
  "version": "0.1.0",
  "description": "Type-safe LRU cache with TTL, max-size eviction, custom keys, and stats.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --coverage",
    "pretest": "node --test dependency-audit.test.cjs"
  },
  "keywords": [
    "lru",
    "cache",
    "ttl",
    "typescript",
    "typed",
    "memoize"
  ],
  "author": "Nripanka Das",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.14",
    "typescript": "^5.4.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nripankadas07/lru-ts"
  },
  "overrides": {
    "js-yaml": {
      "argparse": "2.0.1"
    }
  }
}
